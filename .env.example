# ==============================================================================
# MAAS INDUSTRIAL VENTURES - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MongoDB Atlas for Production on Vercel)
# ------------------------------------------------------------------------------
# In production on Vercel serverless lambdas, provide your MongoDB Atlas connection URI.
# If omitted during local development, the app seamlessly falls back to local SQLite.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=maas_ventures

# ------------------------------------------------------------------------------
# 2. IMAGE CDN & STORAGE (Cloudinary)
# ------------------------------------------------------------------------------
# Global CDN image hosting for admin uploads (hero slides, gallery, master plans).
# Obtain these free credentials from your Cloudinary dashboard: https://cloudinary.com
# If omitted during local development, uploads are saved locally to public/uploads.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ------------------------------------------------------------------------------
# 3. ADMIN PANEL AUTHENTICATION
# ------------------------------------------------------------------------------
# Secure credentials for /admin dashboard access. Change these before going live!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_SECRET=

# ------------------------------------------------------------------------------
# 4. OPTIONAL INTEGRATIONS & WEBHOOKS
# ------------------------------------------------------------------------------
# Optional secondary lead forwarding to external CRM (HubSpot, Salesforce, Zapier, Slack, etc.)
ENQUIRY_WEBHOOK_URL=
ENQUIRY_WEBHOOK_TOKEN=
